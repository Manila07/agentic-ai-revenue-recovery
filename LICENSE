
---

## Fix 2: Human-in-the-Loop Approval

### Backend — Replace `backend/app/api/routes/recovery.py`

```python
from fastapi import APIRouter, Depends, HTTPException
from sqlalchemy.orm import Session
from app.database import get_db

router = APIRouter()


@router.post("/{payment_id}/analyze")
def analyze_payment(payment_id: str, db: Session = Depends(get_db)):
    from app.services.recovery_engine import analyze_payment as analyze
    return analyze(db, payment_id)


@router.post("/{payment_id}/execute")
def execute_recovery(
    payment_id: str,
    human_approved: bool = False,
    db: Session = Depends(get_db),
):
    from app.services.recovery_engine import execute_recovery as execute
    return execute(db, payment_id, human_approved=human_approved)


@router.post("/{payment_id}/approve")
def approve_recovery(payment_id: str, db: Session = Depends(get_db)):
    from app.models.recovery import RecoveryAttempt
    attempt = (
        db.query(RecoveryAttempt)
        .filter(
            RecoveryAttempt.payment_id == payment_id,
            RecoveryAttempt.status == "pending_approval",
        )
        .first()
    )
    if not attempt:
        raise HTTPException(status_code=404, detail="No pending recovery found")
    attempt.status = "approved"
    db.commit()
    return {"message": "Recovery approved", "payment_id": payment_id}


@router.post("/{payment_id}/reject")
def reject_recovery(payment_id: str, db: Session = Depends(get_db)):
    from app.models.recovery import RecoveryAttempt
    attempt = (
        db.query(RecoveryAttempt)
        .filter(
            RecoveryAttempt.payment_id == payment_id,
            RecoveryAttempt.status == "pending_approval",
        )
        .first()
    )
    if not attempt:
        raise HTTPException(status_code=404, detail="No pending recovery found")
    attempt.status = "rejected"
    db.commit()
    return {"message": "Recovery rejected", "payment_id": payment_id}
